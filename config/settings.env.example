# Where the model lives. Any OpenAI-compatible server works.
# Ollama default:        http://localhost:11434/v1
# LM Studio default:     http://localhost:1234/v1
# Unsloth Studio:        check its "local server" screen for the URL
# OpenRouter:            https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen-local
LLM_API_KEY=not-needed-for-local

# Behaviour
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=600
# Maximum tokens the model may generate per call. Needed because reasoning
# models can otherwise generate without limit. Lower for slow local models.
LLM_MAX_TOKENS=4096
# Optional, only sent if non-empty: low/medium/high/xhigh. Cuts down a
# reasoning model's internal "thinking" tokens, which cost real wall-clock
# time on a slow local GPU but are not shown or validated. Leave blank for
# models without a reasoning mode (e.g. most OpenRouter commercial models).
LLM_REASONING_EFFORT=

# Headline window: at most this many days back, even if the previous round is older
MAX_WINDOW_DAYS=14

# Horizon in days that the forecast should describe
HORIZON_DAYS=7

# Uncensored preamble, true or false. Harmless with local abliterated models,
# set false when using OpenRouter commercial models.
UNCENSORED_PREAMBLE=true

# Rough token budget for one prompt. Lower to 12000 for a small local model,
# raise to 60000 for OpenRouter models.
LLM_CONTEXT_BUDGET=24000
