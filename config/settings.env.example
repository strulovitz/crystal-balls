# Where the model lives. Any OpenAI-compatible server works.
# Ollama default:        http://localhost:11434/v1
# LM Studio default:     http://localhost:1234/v1
# Unsloth Studio:        check its "local server" screen for the URL
# OpenRouter:            https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen-local
LLM_API_KEY=not-needed-for-local

# Behaviour
# Matches the model's own documented recommended thinking-mode settings
# (Unsloth official docs for Qwen3.8-27B), verified 2026-10-17.
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=3600
# Maximum tokens the model may generate per call, INCLUDING internal
# reasoning tokens before the final answer. Verified 2026-10-17 from real
# measured benchmarks: at xhigh reasoning (the model's default, full
# quality), one documented real-world call used 25,499 total tokens
# (22,276 thinking + 3,223 answer) — more than a smaller cap would allow.
# 128000 gives real headroom for genuinely hard reasoning without truncating.
LLM_MAX_TOKENS=128000
# Optional, only sent if non-empty: low/medium/high/xhigh. NOTE (2026-10-17):
# for the huihui-ai Qwen3.8-27B abliterated model via Ollama, this field is
# NOT honored (wrong format for this model's chat template) — the model
# just uses its own default (xhigh, best quality). Leave blank unless you
# verify your specific model/server actually supports this field.

# Headline window: at most this many days back, even if the previous round is older
MAX_WINDOW_DAYS=14

# Horizon in days that the forecast should describe
HORIZON_DAYS=7

# Uncensored preamble, true or false. Harmless with local abliterated models,
# set false when using OpenRouter commercial models.
UNCENSORED_PREAMBLE=true

# Rough token budget for one prompt. VERIFIED 2026-10-17 for the real local
# setup (huihui-ai Qwen3.8-27B abliterated via Ollama, 12GB VRAM + 62GB RAM):
# the model's real native max context is 262144 tokens (Unsloth's own docs).
# 120000 leaves real room for LLM_MAX_TOKENS=128000 within that window
# (120000+128000=248000, safe margin), and is still vastly more than this
# project's actual headline-text prompts ever need.
LLM_CONTEXT_BUDGET=120000

# Part 9: headline caps per prompt (forecast prompts, and the judge)
FORECAST_HEADLINE_CAP=150
JUDGE_HEADLINE_CAP=250

# Part 9.6, optional: a different model for judging only (32 small calls per round).
# A mid-priced model from another family through OpenRouter costs pennies per round and removes
# the suspicion that the model grades its own habits. Leave empty to use the main model.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_MAX_TOKENS=
